# Copy the relevant values into the repository-root .env file on the EC2 instance.
# Do not commit the resulting .env.
NODE_ENV=production
PORT=2785
NODE_OPTIONS=--max-old-space-size=768
ENGINE_TYPE=baileys
AUTO_START_SESSIONS=true
BAILEYS_MARK_ONLINE_ON_CONNECT=false
BAILEYS_SYNC_FULL_HISTORY=false
STATUS_SEED_ON_READY=false

# Small-instance profile: retain active work and only three days of completed send history.
MESSAGE_HISTORY_RETENTION_DAYS=3
BULK_MAX_CONCURRENT_BATCHES=2
INBOUND_MEDIA_CONCURRENCY=1
BAILEYS_SESSION_STORE_MAX_ENTRIES=1000
BAILEYS_MESSAGE_STORE_LIMIT=1000
MESSAGE_LIST_INLINE_MEDIA_BUDGET_BYTES=1048576
CHAT_HISTORY_MEDIA_BUDGET_BYTES=5242880
CHAT_MEDIA_ARCHIVE_TTL_DAYS=3
STATS_CACHE_TTL_MS=60000

# Temporary public EC2 location. DASHBOARD_BASE_PATH is consumed during the Docker image build.
DASHBOARD_BASE_PATH=/openwa
BASE_URL=http://ec2-3-104-117-96.ap-southeast-2.compute.amazonaws.com:8026/openwa
DASHBOARD_URL=http://ec2-3-104-117-96.ap-southeast-2.compute.amazonaws.com:8026/openwa
CORS_ORIGINS=http://ec2-3-104-117-96.ap-southeast-2.compute.amazonaws.com:8026

# Required while the temporary public DNS is served over HTTP. Remove this setting after moving to
# a real domain with HTTPS; production otherwise upgrades the dashboard's own HTTP resources.
CSP_UPGRADE_INSECURE_REQUESTS=false

# Generate these independently with: openssl rand -hex 32
API_MASTER_KEY=replace-with-at-least-32-random-characters
API_KEY_PEPPER=replace-with-an-independent-random-value

# Dashboard browser login. Use a unique password of at least 12 characters.
# Maximum three dashboard sessions; a fourth login revokes the oldest.
DASHBOARD_LOGIN_EMAIL=whatsapp@openwa.com
DASHBOARD_LOGIN_PASSWORD=replace-with-a-strong-password

# Set this to the subnet printed by:
# docker network inspect openwa-network --format '{{(index .IPAM.Config 0).Subnet}}'
# TRUSTED_PROXIES=172.18.0.0/16
